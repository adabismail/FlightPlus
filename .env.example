# ============================================================
# FlightPulse — environment configuration
# Copy this file to ".env" and fill in real values.
# docker-compose reads .env automatically.
# ============================================================

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Comma-separated; used by settings ALLOWED_HOSTS in production
ALLOWED_HOSTS=*

# --- PostgreSQL ---
# Inside Docker, DB_HOST must be the compose service name ("db")
# and DB_PORT the container-internal port (5432), not the host mapping.
DB_NAME=flightpulse
DB_USER=flightpulse
DB_PASSWORD=flightpulse
DB_HOST=db
DB_PORT=5432

# --- Celery / Redis ---
# Inside Docker, point at the "redis" service.
CELERY_BROKER_URL=redis://redis:6379/0

# --- Email (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FlightPulse <no-reply@flightpulse.local>

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Sky-Scrapper (RapidAPI) — flight search + prices ---
# Get a key at rapidapi.com → subscribe to the "Sky-Scrapper" API,
# then copy your X-RapidAPI-Key here.
RAPIDAPI_KEY=''
RAPIDAPI_HOST=sky-scrapper.p.rapidapi.com
